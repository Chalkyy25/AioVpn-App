<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- FOCUSED STATE -->
    <item android:state_focused="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#4D7A3CFF" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>

    <!-- SELECTED STATE -->
    <item android:state_selected="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#339B5CFF" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>

    <!-- PRESSED STATE -->
    <item android:state_pressed="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#669B5CFF" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>

    <!-- DEFAULT STATE -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>